# Ubuntu 22.04's glslang 11.8 ships only un-namespaced *Targets.cmake files.
set(_d /usr/lib/x86_64-linux-gnu/cmake)
find_package(SPIRV-Tools CONFIG REQUIRED PATHS ${_d}/SPIRV-Tools NO_DEFAULT_PATH)
find_package(SPIRV-Tools-opt CONFIG REQUIRED PATHS ${_d}/SPIRV-Tools-opt NO_DEFAULT_PATH)
find_package(SPIRV-Tools-link CONFIG REQUIRED PATHS ${_d}/SPIRV-Tools-link NO_DEFAULT_PATH)
if(NOT TARGET glslang)
    include(${_d}/glslangTargets.cmake)
    include(${_d}/SPIRVTargets.cmake)
    include(${_d}/glslang-default-resource-limitsTargets.cmake)
endif()
foreach(t glslang SPIRV glslang-default-resource-limits)
    if(NOT TARGET glslang::${t})
        add_library(glslang::${t} INTERFACE IMPORTED)
        set_target_properties(glslang::${t} PROPERTIES INTERFACE_LINK_LIBRARIES ${t}
            INTERFACE_INCLUDE_DIRECTORIES ${CMAKE_CURRENT_LIST_DIR}/include)
    endif()
endforeach()
set(glslang_VERSION 11.8.0)
set(glslang_FOUND TRUE)
