# Build image for the portable AppImage. glibc 2.35 is the compatibility floor.
#   podman build -t battride-build:ubuntu22.04 packaging/build-image
FROM docker.io/library/ubuntu:22.04
# upgrade: every installed package must be the archive's current version, whose
# source package is still published (collect_sources.py downloads it).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential clang cmake ninja-build pkg-config libsdl2-dev \
        glslang-dev glslang-tools spirv-tools libvulkan-dev vulkan-tools \
        python3 python3-gi python3-cairo gir1.2-gtk-4.0 gir1.2-adw-1 librsvg2-common ffmpeg squashfs-tools \
        ca-certificates patchelf git \
    && rm -rf /var/lib/apt/lists/*
